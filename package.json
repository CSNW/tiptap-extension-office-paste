{
  "name": "@csnw/tiptap-extension-office-paste",
  "version": "0.2.4",
  "description": "Office paste fix extension for tiptap editor",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.browser.json",
    "test": "tsx --test src/*.spec.ts",
    "format": "oxfmt",
    "check-types": "tsc --noEmit -p tsconfig.browser.json && tsc -p tsconfig.node.json",
    "check-formatting": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "publint": "publint"
  },
  "keywords": [
    "tiptap",
    "tiptap-extension"
  ],
  "files": [
    "dist"
  ],
  "repository": "github:CSNW/tiptap-extension-office-paste",
  "author": "CSNW",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CSNW/tiptap-extension-office-paste/issues"
  },
  "homepage": "https://github.com/CSNW/tiptap-extension-office-paste#readme",
  "peerDependencies": {
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3"
  },
  "devDependencies": {
    "@tiptap/core": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@types/node": "^24.13.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
