{
  "name": "@csnw/tiptap-extension-office-paste",
  "version": "0.2.3",
  "description": "Office paste fix extension for tiptap editor",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/*.spec.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "publint": "publint"
  },
  "keywords": [
    "tiptap",
    "tiptap-extension"
  ],
  "files": [
    "dist"
  ],
  "repository": "github:CSNW/tiptap-extension-office-paste",
  "author": "CSNW",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CSNW/tiptap-extension-office-paste/issues"
  },
  "homepage": "https://github.com/CSNW/tiptap-extension-office-paste#readme",
  "peerDependencies": {
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "17.8.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
