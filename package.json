{
  "name": "@csnw/tiptap-extension-office-paste",
  "version": "0.2.1",
  "description": "Office paste fix extension for tiptap editor",
  "main": "./dist/index.cjs",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "node --import tsx --test src/*.spec.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "publint": "publint"
  },
  "tsup": {
    "clean": true
  },
  "keywords": [
    "tiptap",
    "tiptap-extension"
  ],
  "files": [
    "dist"
  ],
  "repository": "github:CSNW/tiptap-extension-office-paste",
  "author": "CSNW",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CSNW/tiptap-extension-office-paste/issues"
  },
  "homepage": "https://github.com/CSNW/tiptap-extension-office-paste#readme",
  "peerDependencies": {
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tiptap/core": "^3.11.0",
    "@tiptap/pm": "^3.11.0",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "publint": "^0.3.15",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
