  "bugs": {
    "url": "https://github.com/CSNW/tiptap-extension-office-paste/issues"
  },
  "homepage": "https://github.com/CSNW/tiptap-extension-office-paste#readme",
  "peerDependencies": {
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3"
  },
  "devDependencies": {
    "@tiptap/core": "^3.0.7",
    "@tiptap/pm": "^3.0.7",
    "@types/node": "^22.17.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
