{
  "name": "@csnw/tiptap-extension-office-paste",
  "version": "0.1.1",
  "description": "Office paste fix extension for tiptap editor",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -r dist/",
    "test": "node --import tsx --test src/*.spec.ts"
  },
  "keywords": [
    "tiptap",
    "tiptap-extension"
  ],
  "files": [
    "dist"
  ],
  "repository": "github:CSNW/tiptap-extension-office-paste",
